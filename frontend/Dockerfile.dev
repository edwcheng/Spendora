# Frontend Development Dockerfile
FROM node:20-alpine

WORKDIR /app

# Install bun
RUN npm install -g bun

# Copy package files
COPY package.json bun.lockb* ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy source files
COPY . .

EXPOSE 5173

# Start in development mode with hot reload
CMD ["bun", "run", "dev", "--host"]
